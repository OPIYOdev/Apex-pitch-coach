{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/index.ts": {
      "includeFiles": "server/**"
    }
  },
  "buildCommand": "mkdir -p node_modules/react-native-css-interop/.cache && npx expo export --platform web",
  "outputDirectory": "dist"
}
